# 生产环境配置
# 由 scripts/common.sh 的 ar_load_env() 自动加载
AF_BUILD_PROFILE=production
LD_LIBRARY_PATH=/opt/coremind/platform/lib

# Python 节点执行依赖：agentflow-runtime 包源码路径
PYTHONPATH=${PYTHONPATH:+$PYTHONPATH:}/opt/coremind/platform/agentflow/packages/agentflow-runtime/src

# LLM API
AF_LLM_API_KEY=sk-ws-H.EDDMREP.gXlt.MEUCIQDS2ezv7sywxvCIry01hm7tkwKSBd0wmaLDz1_cNFgEbAIgK6mwFXsRvqREZbuPPzB1V8C9H3INslUdKhKfDqlV7ig

# ── Agent 包路径（daemon/bridge 启动脚本统一读取）──
# 取消注释即可切换 daemon/bridge 加载的 agent 包（三态模型 ③ 运行实例路径，相对项目根）。
# start_daemon.sh / start_production.sh / start_dev.sh 的 PACKAGE 默认值均读取此变量，
# 旧变量 AGENT_PACKAGE 向后兼容。配合下方 SideCar 覆盖可实现"全套服务切到同一 agent"。
# AF_AGENT_PACKAGE=examples/agent/cloudalbum-agent

# ── SideCar 路由 agent 覆盖（示例：切换到 cloudalbum-agent）──
# 取消注释以下两行即可在启动时覆盖 configs/prod/sidecar.json 的 agent.name/capabilities，
# 无需修改任何代码（sidecar_config.cpp 的 env > 配置文件 > 默认值 优先级保证）。
# 部署多套 sidecar 时，每套容器在各自 .env 中设置不同值即可路由到不同 agent。
# AF_BR_COREMIND_AGENT_ID=cloudalbum-agent
# AF_SIDECAR_CAPABILITIES=photo_album_manage,photo_search,face_recognition