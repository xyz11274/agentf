{
  "server": {
    "listen": "0.0.0.0:17891",
    "uds_biz_path": "/tmp/agentflowd_biz.sock",
    "uds_ctrl_path": "/tmp/agentflowd_ctrl.sock",
    "max_connections": 2048
  },
  "runtime": {
    "role": "master",
    "worker_threads": 8,
    "local_worker_id": "worker-1",
    "worker_default_workflow_threads": 4,
    "worker_control_threads": 2,
    "worker_business_threads": 4,
    "worker_queue_size": 4096
  },
  "deployer": {
    "schedule_interval_ms": 100,
    "heartbeat_timeout_ms": 30000
  },
  "scheduler": {
    "schedule_interval_ms": 50
  },
  "dataref_bridge": {
    "capacity_mb": 1024,
    "redis_url": ""
  },
  "logging": {
    "level": "info",
    "file": "logs/agentflowd.log"
  },
  "trace": {
    "flow_dir": "logs/traces"
  },
  "daemon": {
    "pid_file": "/tmp/agentflowd.pid",
    "drain_timeout_ms": 60000
  },
  "sandbox": {s
    "mode": "e2b",
    "workdir_root": "/var/agentflow/sandbox",
    "snapshot_root": "/var/agentflow/snapshots",
    "sandbox_http_port": 8080,
    "sandbox_max_active": 64,
    "output_max_bytes": 4194304,
    "gc_destroy_ttl_ms": 1800000,
    "gc_recycle_snapshot_ttl_ms": 2592000000,
    "e2b_default_template": "tpl-cb6b9dcbf5784a1487a75971",
    "e2b_api_key": "e2b_000000000",
    "e2b_api_url": "http://218.245.96.148:30030",
    "e2b_ca_cert_path": "configs/certs/e2b_CA.pem",
    "e2b_network_allow_out": "[\"10.0.0.0/8\",\"43.0.0.0/8\",\"218.0.0.0/8\"]",
    "image_name": "agentflow-sandbox:v1",
    "allow_fallback": false
  },
  "agents": []
}
