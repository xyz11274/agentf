# ── Bridge 测试环境环境变量模板 ──────────────────────────────────
# 复制此文件为 bridge.env 并按需修改：
#   cp configs/test/bridge.env.example configs/test/bridge.env
#
# 被 configs/test/bridge.yaml 的 ${VAR:-default} 展开捕获。
# 回归测试脚本（regression_test.sh）源 bridge.env 后自动生效。
#
# 未设置的变量会使用 bridge.yaml 中 :-(default) 的值。

# ── 环境模式 ─────────────────────────────────────────────────────
# 切换 Bridge 加载 configs/{env}/bridge.yaml
#   dev  → configs/dev/bridge.yaml
#   test → configs/test/bridge.yaml
#   prod → configs/prod/bridge.yaml
export AF_BR_ENV=test

# ── LLM 配置（agent 默认值，load_agent 时注入到 agent .env 文件）─
# 取消注释以使用真实 LLM（需要有效的 API Key）
# export AF_LLM_API_KEY=sk-your-api-key
# export AF_LLM_BASE_URL=https://api.example.com/v1
# export AF_LLM_MODEL=gpt-4o

# ── 日志 ─────────────────────────────────────────────────────────
# export AF_BR_LOG_LEVEL=DEBUG

# ── 其他配置（按需取消注释） ────────────────────────────────────
# export AF_BR_DAEMON_HOST=127.0.0.1
# export AF_BR_DAEMON_PORT=17891
# export AF_BR_LISTEN=0.0.0.0:8199
# export AF_BR_SESSION_DB_PATH=/tmp/agentflow/test-sessions.db
# export AF_BR_SESSION_SYNC_INTERVAL=10.0
# export AF_BR_REQUEST_TIMEOUT_SECONDS=30.0
# export AF_BR_CHAT_TURN_TIMEOUT_SECONDS=120.0
# export AF_BR_UPLOADS_DIR=/tmp/agentflow/test-uploads
# export AF_BR_ARTIFACT_PUBLIC_BASE_URL=http://localhost:8199/health
# export AF_BR_SIDECAR_ENABLED=false
# export AF_BR_AISF_ADAPTER_MODE=async
# export AF_BR_AISF_ADAPTER_UPSTREAM_CALLBACK_PORT=23767