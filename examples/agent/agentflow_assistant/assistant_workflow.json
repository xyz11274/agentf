{
  "id": "agentflow-assistant-run",
  "version": "1.0",
  "name": "agentflow-assistant-run",
  "description": "LLM think-and-act loop — Q&A guided agent package creation assistant",
  "nodes": [
    {
      "id": "assistant_think",
      "name": "Assistant Think and Act",
      "type": "task",
      "execution_mode": "python_script",
      "command": "./nodes/assistant_loop.py",
      "working_dir": "examples/agent/agentflow_assistant",
      "json_output": true,
      "inputs": [
        {"name": "input", "type": "string", "required": true},
        {"name": "completed_skill_name", "type": "string", "required": false},
        {"name": "session_id", "type": "string", "required": true},
        {"name": "dialogue_id", "type": "string", "required": false}
      ],
      "outputs": [
        {"name": "response", "type": "string"}
      ],
      "enable_hot_reload": false,
      "timeout_ms": 60000
    }
  ],
  "edges": []
}
