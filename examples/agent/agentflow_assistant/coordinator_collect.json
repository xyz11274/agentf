{
  "id": "coordinator-collect",
  "version": "1.0",
  "name": "coordinator-collect",
  "description": "Collects assistant output from DataBus and returns to client",
  "nodes": [
    {
      "id": "collector",
      "name": "Assistant Output Collector",
      "type": "task",
      "execution_mode": "python_script",
      "command": "./nodes/coordinator_collect.py",
      "working_dir": "examples/agent/agentflow_assistant",
      "json_output": true,
      "timeout_ms": 1000,
      "inputs": [
        {"name": "input", "type": "string", "required": true},
        {"name": "session_id", "type": "string", "required": true},
        {"name": "dialogue_id", "type": "string", "required": false}
      ],
      "outputs": [
        {"name": "response", "type": "string"}
      ]
    }
  ],
  "edges": []
}
