{
  "name": "BasicAgent",
  "version": "1.0.0",
  "description": "Basic execution agent example with shell and Python workflows",
  "session_pool_size": 1,
  "tasks": [
    {
      "id": 0,
      "type": "contextupdater",
      "scope": "agent",
      "description": "Update basic agent context",
