      "workflow_pool_size": 2
    },
    {
      "id": 1,
      "type": "dispatcher",
      "description": "Dispatch user requests",
      "workflow_file": "workflow_01.json",
      "workflow_pool_size": 3
    },
    {
      "id": 2,
      "type": "coordinator",
      "description": "Coordinate task outputs",
      "workflow_file": "coordinator_workflow.json",
      "workflow_pool_size": 2
    },
    {
      "id": 3,
      "type": "skill",
      "description": "Run basic conversation skill",
      "workflow_file": "workflow.json",
      "skill": {
        "name": "basic-conversation",
        "config_dir": "skills/basic-conversation",
        "instance_pool_size": 2
      },
      "workflow_pool_size": 2
    },
    {
      "id": 4,
      "type": "skill",
      "description": "Run calculator execution skill",
      "workflow_file": "calculator_workflow.json",
      "skill": {
        "name": "calculator-executor",
        "config_dir": "skills/calculator-executor",
        "instance_pool_size": 1
      },
      "workflow_pool_size": 1
    }
  ],
  "max_workflows": 10,
  "max_concurrent_workflows": 5
}