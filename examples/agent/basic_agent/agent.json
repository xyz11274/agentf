{
  "name": "BasicAgent",
  "version": "1.0.0",
  "description": "Basic agent example",
  "session_pool_size": 1,
  "tasks": [
    {
      "id": 0,
      "type": "contextupdater",
      "description": "Update basic agent context",
      "workflow_file": "workflow_01.json",
      "workflow_pool_size": 2
    }
  ],
  "sessions": [
    {
      "id": 0,
      "description": "Homogeneous pooled session template",
