{
  "id": "calculator-workflow",
  "version": "1.0",
  "name": "calculator-agent-workflow",
  "description": "Calculator agent workflow for performing arithmetic operations with typed IO",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "name": "Start Node",
      "outputs": [
        {"name": "num1", "type": "float"},
        {"name": "num2", "type": "float"}
      ]
    },
    {
      "id": "validate_input",
      "type": "task",
      "name": "Validate Input",
      "inputs": [
        {"name": "num1", "type": "float", "required": true},
        {"name": "num2", "type": "float", "required": true}
      ],
      "outputs": [
        {"name": "validated_num1", "type": "float"},
        {"name": "validated_num2", "type": "float"},
        {"name": "operation", "type": "string"}
      ]
    },
    {
      "id": "add_numbers",
      "type": "task",
      "name": "Add Numbers",
      "inputs": [
        {"name": "validated_num1", "type": "float"},
        {"name": "validated_num2", "type": "float"}
      ],
      "outputs": [
        {"name": "result", "type": "float"}
      ]
    },
    {
      "id": "end",
      "type": "end",
      "name": "End Node",
      "inputs": [
        {"name": "result", "type": "float", "required": true}
      ]
    }
  ],
  "edges": [
    {
      "id": "edge_start_to_validate",
      "source": "start",
      "target": "validate_input",
      "source_outputs": ["num1", "num2"],
      "target_inputs": ["num1", "num2"],
      "transfer_mode": "value"
    },
    {
      "id": "edge_validate_to_add",
      "source": "validate_input",
      "target": "add_numbers",
      "source_outputs": ["validated_num1", "validated_num2"],
      "target_inputs": ["validated_num1", "validated_num2"],
      "transfer_mode": "value"
    },
    {
      "id": "edge_add_to_end",
      "source": "add_numbers",
      "target": "end",
      "source_outputs": ["result"],
      "target_inputs": ["result"],
      "transfer_mode": "value"
    }
  ],
  "metadata": {
    "author": "AgentFlow Team",
    "version": "1.0.0",
    "tags": ["calculator", "example"]
  }
}
