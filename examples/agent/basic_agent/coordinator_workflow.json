{
  "id": "basic-coordinator-workflow",
  "version": "1.0",
  "name": "basic-coordinator-workflow",
  "description": "Coordinator workflow with session/task creation nodes",
  "nodes": [
    {
      "id": "session_create",
      "name": "Session Create Node",
      "type": "task",
      "execution_mode": "shell_script",
      "command": "node_basic.sh"
    },
    {
      "id": "task_create",
      "name": "Task Create Node",
      "type": "task",
      "execution_mode": "shell_script",
      "command": "node_basic.sh"
    }
  ],
  "edges": [
    {
      "id": "edge_session_to_task",
      "source": "session_create",
      "target": "task_create"
    }
  ]
}
