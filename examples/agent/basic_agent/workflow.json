{
  "id": "basic-workflow",
  "version": "1.0",
  "name": "basic-agent-workflow",
  "description": "Basic agent workflow example",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "name": "Start Node"
    },
    {
      "id": "process",
      "type": "task",
      "name": "Process Task",
      "action": "process_data",
      "inputs": {
        "data": "${input.data}"
      }
    },
    {
      "id": "end",
      "type": "end",
      "name": "End Node"
    }
  ],
  "edges": [
    {
      "id": "edge_start_to_process",
      "source": "start",
      "target": "process"
    },
    {
      "id": "edge_process_to_end",
      "source": "process",
      "target": "end"
    }
  ],
  "metadata": {
    "author": "AgentFlow Team",
    "version": "1.0.0",
    "tags": ["basic", "example"]
  }
}
