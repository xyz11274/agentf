# Text model; never put actual secrets in this example.
AF_LLM_API_KEY=
AF_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
AF_LLM_MODEL=deepseek-v4-flash
AF_LLM_THINKING_MODE=disabled
AF_COORDINATOR_VERSION=v1
AF_SESSIONLOG_ENABLED=1

# Real execution is the default. fixture is only for deterministic backend tests.
BUSINESS_EXECUTION_MODE=real
BUSINESS_TIMEZONE=Asia/Shanghai
# Main agent RPC: 17893; local APIs and reminder scheduler: 17894.
BUSINESS_BACKEND_PORT=17894
# BUSINESS_SIM_DB=/absolute/path/to/outputs/business.sqlite3

# Independent image model configuration.
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
OPENAI_IMAGE_MODEL=doubao-seedream-5.0-lite

# Optional search provider. Without it, public Bing RSS is used;
# weather uses the real Open-Meteo forecast API with no local weather fixture.
WEBSEARCH_BASE_URL=
WEBSEARCH_API_KEY=
WEBSEARCH_MODEL=qwen-plus

# Real browser workflows may require more than the default eight tool rounds.
AF_MAX_SKILL_TASK_ITERATIONS=24
# Optional private Chromium installation or proxy; current proxy env is used by default.
# BUSINESS_BROWSER_EXECUTABLE=/absolute/path/to/chrome
# BUSINESS_BROWSER_PROXY=http://127.0.0.1:7890
# BUSINESS_BROWSER_ALLOWED_ORIGINS=https://exact-site.example
# BUSINESS_BROWSER_LOCAL_ORIGINS=http://127.0.0.1:8080

# Optional physical device adapters. HTTPS is required for Home Assistant unless the operator opts into HTTP.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
HOME_ASSISTANT_ALLOW_HTTP=0
BUSINESS_ADB_EXECUTABLE=
# Optional action name of an operator-installed receiver that accepts text_b64.
BUSINESS_ADB_TEXT_RECEIVER=

# Optional real SMTP email connector. TLS is required outside explicitly allowed test environments.
BUSINESS_SMTP_HOST=
BUSINESS_SMTP_PORT=587
BUSINESS_SMTP_SECURITY=starttls
BUSINESS_SMTP_USERNAME=
BUSINESS_SMTP_PASSWORD=
BUSINESS_SMTP_FROM=
BUSINESS_SMTP_ALLOW_INSECURE=0

# Optional real JSON webhook connector. Origins are comma-separated exact scheme://host:port values.
BUSINESS_WEBHOOK_URL=
BUSINESS_WEBHOOK_ALLOWED_ORIGINS=
BUSINESS_WEBHOOK_TOKEN=
BUSINESS_WEBHOOK_ALLOW_HTTP=0
BUSINESS_WEBHOOK_ALLOW_PRIVATE=0
