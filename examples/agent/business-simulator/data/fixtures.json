  "knowledge": [
    {
      "id": "cloud-overview",
      "title": "云手机是什么及功能",
      "keywords": [
        "云手机",
        "联通",
        "功能",
        "通话",
        "电影"
      ],
      "text": "样例产品是一台在云端运行的虚拟安卓手机，通过客户端远程操作，可安装应用、聊天、看视频和使用应用分身。",
      "source": "simulation-product-manual/v1"
    },
    {
      "id": "cloud-login",
      "title": "注册登录",
      "keywords": [
        "注册",
        "登录",
        "验证码"
      ],
      "text": "样例流程：打开客户端或 H5，进入登录页，使用本机号码或手机号验证码登录。首次成功登录创建样例账号。",
      "source": "simulation-product-manual/v1"
    },
    {
      "id": "cloud-count",
      "title": "设备数量与免费领取",
      "keywords": [
        "数量",
        "多少台",
        "免费",
        "领取"
      ],
      "text": "样例规则：同一账号可管理多台设备，一笔订单一台；免费试用资格需查询活动规则与账号权益，本模拟没有真实账号资格。",
      "source": "simulation-product-manual/v1"
    },
    {
      "id": "cloud-activation",
      "title": "订购与生效",
      "keywords": [
        "生效",
        "订购",
        "支付"
      ],
      "text": "样例流程：订单支付并完成开通后进入设备列表查看状态；未获得订单回执不能声称开通成功。",
      "source": "simulation-product-manual/v1"
    },
    {
      "id": "cloud-clone",
      "title": "应用分身与一键上云",
      "keywords": [
        "分身",
        "一键上云"
      ],
      "text": "样例支持将本地应用信息同步到云手机后独立安装运行；分身数据与原应用隔离，需重新登录。",
      "source": "simulation-product-manual/v1"
    },
    {
      "id": "cloud-crash",
      "title": "应用闪退排查",
      "keywords": [
        "闪退",
        "打不开"
      ],
      "text": "排查版本兼容性、应用缓存和剩余空间；先重启应用再尝试更新。重装前先备份，不承诺保留未同步的数据。",
      "source": "simulation-product-manual/v1"
    },
    {
      "id": "cloud-lag",
      "title": "画面卡顿排查",
      "keywords": [
        "卡顿",
        "网络",
        "流畅"
      ],
      "text": "检查网络延迟和带宽，尝试稳定 Wi-Fi、降低画质、关闭本地占网程序，并核对云端负载；仍异常时记录时间交由服务支持。",
      "source": "simulation-product-manual/v1"
    },
    {
      "id": "cloud-data",
      "title": "活动流量权益",
      "keywords": [
        "30G",
        "流量",
        "领取条件"
      ],
      "text": "30G 活动资格、时效和费用依赖实际活动与账号状态。本模拟未接入权益系统，不能确认是否符合领取条件。",
      "source": "simulation-product-manual/v1"
    },
    {
      "id": "cloud-migrate",
      "title": "数据迁移和上传",
      "keywords": [
        "迁移",
        "上传",
        "文件",
        "备份"
      ],
      "text": "样例流程：确认两端设备和空间，使用文件上传或备份恢复功能，迁移后检查文件完整性。上传失败先检查网络、权限、格式和容量。",
      "source": "simulation-product-manual/v1"
    },
    {
      "id": "cloud-app",
      "title": "应用安装和卸载",
      "keywords": [
        "安装",
        "卸载",
        "自己",
        "APP"
      ],
      "text": "样例允许安装兼容应用；可通过客户端入口上传安装包。卸载本地客户端与退订云设备是不同动作，退订前检查数据备份。",
      "source": "simulation-product-manual/v1"
    },
    {
      "id": "cloud-billing",
      "title": "通话和流量费用",
      "keywords": [
        "拨打",
        "费用",
        "收费",
        "下载",
        "流量"
      ],
      "text": "通话、套餐以及本地客户端的视频传输流量分别计费，具体以实际套餐为准；云端下载不等于本地连接完全不耗流量。",
      "source": "simulation-product-manual/v1"
    },
    {
      "id": "cloud-batch",
      "title": "群控能力",
      "keywords": [
        "群控",
        "批量"
      ],
      "text": "当前样例面向单设备交互，不提供群控；不能从此推断真实产品能力。",
      "source": "simulation-product-manual/v1"
    }
  ],
