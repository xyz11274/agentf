{
  "id": "calculator-workflow",
  "version": "1.0",
  "name": "calculator-agent-workflow",
  "description": "Calculator agent workflow for performing arithmetic operations",
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "name": "Start Node"
    },
    {
      "id": "validate_input",
      "type": "task",
      "name": "Validate Input",
      "action": "validate",
      "inputs": {
        "num1": "${input.num1}",
        "num2": "${input.num2}"
      }
    },
    {
      "id": "add_numbers",
      "type": "task",
      "name": "Add Numbers",
      "action": "add",
      "inputs": {
        "a": "${validate_input.output.num1}",
        "b": "${validate_input.output.num2}"
      }
    },
    {
      "id": "end",
      "type": "end",
      "name": "End Node"
    }
  ],
  "edges": [
    {
      "id": "edge_start_to_validate",
      "source": "start",
      "target": "validate_input"
    },
    {
      "id": "edge_validate_to_add",
      "source": "validate_input",
      "target": "add_numbers"
    },
    {
      "id": "edge_add_to_end",
      "source": "add_numbers",
      "target": "end"
    }
  ],
  "metadata": {
    "author": "AgentFlow Team",
    "version": "1.0.0",
    "tags": ["calculator", "example"]
  }
}
