{
  "name": "ClawAgent",
  "version": "1.0.0",
  "description": "Dispatcher-first claw agent example backed by vendored jiuwenclaw",
  "session_pool_size": 1,
  "tasks": [
    {
      "id": 0,
      "type": "dispatcher",
      "description": "Dispatch user requests into jiuwenclaw",
      "workflow_file": "dispatcher_workflow.json",
      "workflow_pool_size": 2
    },
    {
      "id": 1,
      "type": "coordinator",
      "description": "Coordinate claw outputs when needed",
      "workflow_file": "coordinator_workflow.json",
      "workflow_pool_size": 1
    },
    {
      "id": 2,
      "type": "skill",
      "description": "Reserved claw skill task",
      "workflow_file": "claw_skill_workflow.json",
      "skill": {
        "name": "claw-direct",
        "config_dir": "runtime",
        "instance_pool_size": 1
      },
      "workflow_pool_size": 1
    }
  ],
  "max_workflows": 8,
  "max_concurrent_workflows": 4
}