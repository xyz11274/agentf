{
  "id": "claw-dispatcher-workflow",
  "version": "1.0",
  "name": "Claw Dispatcher",
  "description": "Dispatch user requests directly into vendored jiuwenclaw",
  "nodes": [
    {
      "id": "claw_dispatch",
      "name": "Claw Dispatch Node",
      "type": "task",
      "execution_mode": "python_script",
      "command": "./nodes/python/claw_dispatch_node.py",
      "json_output": true,
      "timeout_ms": 10000,
      "inputs": [
        {"name": "session_id", "type": "string", "required": true},
        {"name": "user_text", "type": "string", "required": true}
      ],
      "outputs": [
        {"name": "response", "type": "string"},
        {"name": "claw_trace", "type": "string"}
      ]
    }
  ],
  "edges": []
}
