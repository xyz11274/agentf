# AgentFlow — DailyQAAssistant Agent 环境配置
# 复制此文件为 .env 并填入真实值
#   cp .env.example .env
# 节点 shell wrapper（nodes/*.sh）启动前会自动 source .env

# ── LLM 配置（主模型）───────────────────────────────────────────
# agent.md 的 model 字段 > AF_LLM_MODEL > AF_FALLBACK_LLM_MODEL
# AF_LLM_API_KEY 优先，兜底 API_KEY，再兜底 AF_FALLBACK_LLM_API_KEY
AF_LLM_API_KEY="sk-ws-H.PMRPYHL.QrDT.MEQCIGAlhxGeNT27M1Jt6uMrtdma5DrF4eee9ecjiQjYLq5KAiBB8FxLfNyzNOw9PFZAle3VizaonIRyFjooXDRVZdDNHA"
AF_LLM_BASE_URL="https://llm-7ztiqbmxzp9wduvz.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"
AF_LLM_MODEL="deepseek-v4-flash"

# ── LLM 降级配置（当主模型不可用时的备选）────────────────────
AF_FALLBACK_LLM_API_KEY=""
AF_FALLBACK_LLM_BASE_URL="https://api.minimax.io/v1"
AF_FALLBACK_LLM_MODEL="MiniMax-M3"

# ── Coordinator / Skill 迭代限制 ────────────────────────────────
# AF_MAX_COORDINATOR_ITERATIONS=10
# AF_MAX_SKILL_TASK_ITERATIONS=8

# ── Token 预算与上下文压缩 ──────────────────────────────────────
# AF_MODEL_MAX_TOKENS=128000
# AF_COMPACTION_THRESHOLD=0.8

# ── 业务配置：心知天气（weather-query skill）──────────────────
SENIVERSE_API_KEY="SzEOAnHGwBl3yU_uL"

# ── 业务配置：高德地图（amap-nearby skill）────────────────────
AMAP_API_KEY="4b4d9e2e94d703829a166a7667665d86"

# ── 业务配置：文生图（image-gen skill，OpenAI 兼容 multimodal-generation 端点）
IMAGE_API_KEY="sk-ws-H.PMRPYHL.QrDT.MEQCIGAlhxGeNT27M1Jt6uMrtdma5DrF4eee9ecjiQjYLq5KAiBB8FxLfNyzNOw9PFZAle3VizaonIRyFjooXDRVZdDNHA"
IMAGE_BASE_URL="https://llm-7ztiqbmxzp9wduvz.cn-beijing.maas.aliyuncs.com"
IMAGE_MODEL="wan2.7-image"

# ── 业务配置：网页实时搜索（web-search skill，compatible-mode enable_search）──
