WEBSEARCH_BASE_URL="https://llm-7ztiqbmxzp9wduvz.cn-beijing.maas.aliyuncs.com"
WEBSEARCH_MODEL="qwen-plus"

# ── LLM 请求调优 ────────────────────────────────────────────────
# AF_MAX_COMPLETION_TOKENS=8192
# AF_LLM_TIMEOUT=120
# AF_LLM_CONNECT_TIMEOUT=5
