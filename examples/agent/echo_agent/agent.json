{
  "name": "EchoAgent",
  "version": "1.0.0",
  "description": "Simple echo agent that responds with 'Hello {input}!'",
  "session_pool_size": 1,
  "tasks": [
    {
      "id": 0,
      "type": "contextupdater",
      "description": "Update agent context",
      "workflow_file": "echo_workflow.json",
      "workflow_pool_size": 1
    }
  ],
  "sessions": [
    {
      "id": 0,
      "description": "Echo session template",
      "task_count": 3,
      "tasks": [
        {
          "id": 0,
          "type": "dispatcher",
          "description": "Dispatch user requests",
          "next_skills": ["echo-skill"],
          "max_concurrent_skills": 1
        },
        {
          "id": 1,
          "type": "coordinator",
          "description": "Coordinate responses",
          "workflow_file": "coordinator_workflow.json",
          "workflow_pool_size": 1
        },
        {
          "id": 2,
          "type": "skill",
          "description": "Echo skill",
          "workflow_file": "echo_workflow.json",
          "skill": {
            "name": "echo-skill",
            "config_dir": "skills/echo",
            "instance_pool_size": 1
          },
          "workflow_pool_size": 1
        }
      ]
    }
  ],
  "max_workflows": 10,
  "max_concurrent_workflows": 5
}