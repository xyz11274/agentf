{
  "id": "harness-coordinator-workflow",
  "version": "1.0",
  "name": "harness-coordinator-workflow",
  "description": "Coordinator drives the harness loop: re-selects next skill based on accumulated results, or terminates with a response.",
  "nodes": [
    {
      "id": "coordinator_select",
      "name": "coordinator-select",
      "type": "task",
      "execution_mode": "python_script",
      "command": "examples/agent/harness_agent/package/nodes/python/coordinator_select.py",
      "json_output": true,
      "inputs": [
        {"name": "session_id", "type": "string", "required": false},
        {"name": "dialogue_id", "type": "string", "required": false},
        {"name": "user_text", "type": "string", "required": false},
        {"name": "completed_skill_name", "type": "string", "required": false}
      ],
      "outputs": [
        {"name": "next_skills", "type": "string"},
        {"name": "selected_skills", "type": "string"},
        {"name": "response", "type": "string"},
        {"name": "coordinator_done", "type": "bool"}
      ]
    }
  ],
  "edges": []
}
