{
  "id": "harness-skill-compose-workflow",
  "version": "1.0",
  "name": "harness-skill-compose-workflow",
  "description": "Harness skill: compose.",
  "nodes": [
    {
      "id": "compose_node",
      "name": "harness-skill-compose",
      "type": "task",
      "execution_mode": "python_script",
      "command": "examples/agent/harness_agent/package/nodes/python/skill_node.py",
      "args": ["compose"],
      "json_output": true,
      "inputs": [
        {"name": "session_id", "type": "string", "required": false},
        {"name": "dialogue_id", "type": "string", "required": false},
        {"name": "user_text", "type": "string", "required": false}
      ],
      "outputs": [
        {"name": "skill_text", "type": "string"},
        {"name": "skill_result", "type": "string"},
        {"name": "status", "type": "string"},
        {"name": "can_handle", "type": "bool"},
        {"name": "skill_completed", "type": "bool"}
      ]
    }
  ],
  "edges": []
}
