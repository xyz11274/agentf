{
  "name": "LLMQueryAgent",
  "version": "1.0.0",
  "description": "LLM query agent that responds to user prompts using AI with async streaming",
  "session_pool_size": 1,
  "tasks": [
    {
      "id": 0,
      "type": "contextupdater",
      "description": "Update agent context",
      "workflow_file": "llm_query_workflow.json",
      "workflow_pool_size": 1,
      "scope": "agent"
    },
    {
      "id": 1,
      "type": "dispatcher",
      "description": "Dispatch user requests",
      "next_skills": ["llm-query-async-skill"],
      "max_concurrent_skills": 1
    },
    {
      "id": 2,
      "type": "coordinator",
      "description": "Coordinate responses",
      "workflow_pool_size": 1
    },
    {
      "id": 3,
      "type": "skill",
      "description": "LLM query async skill with streaming",
      "workflow_file": "llm_query_async_workflow.json",
      "skill": {
        "name": "llm-query-async-skill",
        "config_dir": "skills/llm_query",
        "instance_pool_size": 1
      },
      "workflow_pool_size": 1
    }
  ],
  "max_workflows": 10,
  "max_concurrent_workflows": 5
}