{
  "id": "chain-test-workflow",
  "version": "1.0",
  "name": "Multi-Language Chain Test Workflow",
  "description": "Chains C++ -> Python -> Go -> Shell nodes to test DataBus interoperability",
  "nodes": [
    {
      "id": "cpp_producer",
      "name": "C++ Data Producer",
      "type": "task",
      "execution_mode": "so_library",
      "command": "lib/libchain_cpp_node.so",
      "function_name": "chain_cpp_producer",
      "inputs": [
        {"name": "session_id", "type": "string", "required": true},
        {"name": "dialogue_id", "type": "string", "required": false}
      ],
      "outputs": [
        {"name": "status", "type": "string"},
        {"name": "data_key", "type": "string"}
      ],
      "timeout_ms": 10000
    },
    {
      "id": "python_transformer",
      "name": "Python Data Transformer",
      "type": "task",
      "execution_mode": "python_script",
      "command": "nodes/python_transformer.py",
      "inputs": [
        {"name": "session_id", "type": "string", "required": true},
        {"name": "dialogue_id", "type": "string", "required": false}
      ],
      "outputs": [
        {"name": "status", "type": "string"},
        {"name": "transformed", "type": "string"}
      ],
      "timeout_ms": 10000
    },
    {
      "id": "go_processor",
      "name": "Go Data Processor",
      "type": "task",
      "execution_mode": "go_script",
      "command": "nodes/go_processor.go",
      "inputs": [
        {"name": "session_id", "type": "string", "required": true},
        {"name": "dialogue_id", "type": "string", "required": false}
      ],
      "outputs": [
        {"name": "status", "type": "string"},
        {"name": "processed", "type": "string"}
      ],
      "timeout_ms": 10000
    },
    {
      "id": "shell_verifier",
      "name": "Shell Data Verifier",
      "type": "task",
      "execution_mode": "shell_script",
      "command": "nodes/shell_verifier.sh",
      "inputs": [
        {"name": "session_id", "type": "string", "required": true},
        {"name": "dialogue_id", "type": "string", "required": false}
      ],
      "outputs": [
        {"name": "status", "type": "string"},
        {"name": "verification_result", "type": "string"}
      ],
      "timeout_ms": 10000
    }
  ],
  "edges": [
    {
      "id": "edge_cpp_to_python",
      "from": "cpp_producer",
      "to": "python_transformer"
    },
    {
      "id": "edge_python_to_go",
      "from": "python_transformer",
      "to": "go_processor"
    },
    {
      "id": "edge_go_to_shell",
      "from": "go_processor",
      "to": "shell_verifier"
    }
  ]
}