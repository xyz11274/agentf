{
  "id": "data-pipeline-workflow",
  "version": "1.0",
  "name": "Data Pipeline Workflow",
  "description": "Sub-workflow that processes data and calls validation workflow",
  "nodes": [
    {
      "id": "fetch_data",
      "name": "Fetch Data",
      "type": "task",
      "execution_mode": "shell_script",
      "command": "fetch_data.sh"
    },
    {
      "id": "validate_data",
      "name": "Validate Data",
      "type": "workflow",
      "workflow_ref": "validation_workflow.json"
    },
    {
      "id": "transform_data",
      "name": "Transform Data",
      "type": "task",
      "execution_mode": "shell_script",
      "command": "transform_data.sh"
    }
  ],
  "edges": [
    {
      "id": "edge_fetch_to_validate",
      "source": "fetch_data",
      "target": "validate_data"
    },
    {
      "id": "edge_validate_to_transform",
      "source": "validate_data",
      "target": "transform_data"
    }
  ],
  "metadata": {
    "author": "AgentFlow Team",
    "description": "Data pipeline with nested validation workflow call"
  }
}