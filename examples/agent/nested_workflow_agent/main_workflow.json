{
  "id": "main-workflow",
  "version": "1.0",
  "name": "Main Workflow",
  "description": "Main workflow that orchestrates sub-workflows using workflow_ref",
  "nodes": [
    {
      "id": "start",
      "name": "Start Node",
      "type": "start"
    },
    {
      "id": "data_pipeline",
      "name": "Data Pipeline Sub-Workflow",
      "type": "workflow",
      "workflow_ref": "data_pipeline.json"
    },
    {
      "id": "final_processing",
      "name": "Final Processing Sub-Workflow",
      "type": "workflow",
      "workflow_ref": "processing_workflow.json"
    },
    {
      "id": "end",
      "name": "End Node",
      "type": "end"
    }
  ],
  "edges": [
    {
      "id": "edge_start_to_pipeline",
      "source": "start",
      "target": "data_pipeline"
    },
    {
      "id": "edge_pipeline_to_processing",
      "source": "data_pipeline",
      "target": "final_processing"
    },
    {
      "id": "edge_processing_to_end",
      "source": "final_processing",
      "target": "end"
    }
  ],
  "metadata": {
    "author": "AgentFlow Team",
    "description": "Main workflow calls two sub-workflows in sequence"
  }
}