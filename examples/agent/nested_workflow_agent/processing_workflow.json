{
  "id": "processing-workflow",
  "version": "1.0",
  "name": "Processing Workflow",
  "description": "Sub-workflow for final data processing - called by main workflow",
  "nodes": [
    {
      "id": "aggregate_data",
      "name": "Aggregate Data",
      "type": "task",
      "execution_mode": "shell_script",
      "command": "aggregate_data.sh"
    },
    {
      "id": "generate_output",
      "name": "Generate Output",
      "type": "task",
      "execution_mode": "shell_script",
      "command": "generate_output.sh"
    },
    {
      "id": "persist_results",
      "name": "Persist Results",
      "type": "task",
      "execution_mode": "shell_script",
      "command": "persist_results.sh"
    }
  ],
  "edges": [
    {
      "id": "edge_aggregate_to_generate",
      "source": "aggregate_data",
      "target": "generate_output"
    },
    {
      "id": "edge_generate_to_persist",
      "source": "generate_output",
      "target": "persist_results"
    }
  ],
  "metadata": {
    "author": "AgentFlow Team",
    "description": "3-node processing pipeline"
  }
}