{
  "id": "validation-workflow",
  "version": "1.0",
  "name": "Validation Workflow",
  "description": "Sub-workflow for data validation - called by data_pipeline",
  "nodes": [
    {
      "id": "check_schema",
      "name": "Check Schema",
      "type": "task",
      "execution_mode": "shell_script",
      "command": "check_schema.sh"
    },
    {
      "id": "validate_fields",
      "name": "Validate Fields",
      "type": "task",
      "execution_mode": "shell_script",
      "command": "validate_fields.sh"
    },
    {
      "id": "validation_report",
      "name": "Generate Validation Report",
      "type": "task",
      "execution_mode": "shell_script",
      "command": "validation_report.sh"
    }
  ],
  "edges": [
    {
      "id": "edge_schema_to_fields",
      "source": "check_schema",
      "target": "validate_fields"
    },
    {
      "id": "edge_fields_to_report",
      "source": "validate_fields",
      "target": "validation_report"
    }
  ],
  "metadata": {
    "author": "AgentFlow Team",
    "description": "3-node validation pipeline"
  }
}