{
  "id": "session-coordinator-workflow",
  "version": "1.0",
  "name": "session-coordinator-workflow",
  "nodes": [
    {
      "id": "load_context",
      "name": "load-session-context",
      "type": "task",
      "execution_mode": "python_script",
      "command": "examples/agent/openjiuwen_multi_session_chat/nodes/python/load_session_context_node.py",
      "json_output": true,
      "inputs": [
        {"name": "session_id", "type": "string", "required": true},
        {"name": "user_text", "type": "string", "required": true}
      ],
      "outputs": [
        {"name": "session_context", "type": "string"}
      ]
    },
    {
      "id": "build_catalog",
      "name": "build-skill-catalog",
      "type": "task",
      "execution_mode": "python_script",
      "command": "examples/agent/openjiuwen_multi_session_chat/nodes/python/build_skill_catalog_node.py",
      "json_output": true,
      "outputs": [
        {"name": "skill_catalog", "type": "string"}
      ]
    },
    {
      "id": "result_aware_path",
      "name": "result-aware-selector",
      "type": "task",
      "execution_mode": "python_script",
      "command": "examples/agent/openjiuwen_multi_session_chat/nodes/python/select_skill_path_node.py",
      "args": ["coordinator", "result_aware"],
      "json_output": true,
      "inputs": [
        {"name": "session_id", "type": "string", "required": true},
        {"name": "user_text", "type": "string", "required": true},
        {"name": "session_context", "type": "string", "required": true},
        {"name": "skill_catalog", "type": "string", "required": true},
        {"name": "selected_skills", "type": "string", "required": true},
        {"name": "partial_skill_results", "type": "string"}
      ],
      "outputs": [
        {"name": "candidate_list", "type": "string"}
      ]
    },
    {
      "id": "dependency_path",
      "name": "dependency-selector",
      "type": "task",
      "execution_mode": "python_script",
      "command": "examples/agent/openjiuwen_multi_session_chat/nodes/python/select_skill_path_node.py",
      "args": ["coordinator", "dependency"],
      "json_output": true,
      "inputs": [
        {"name": "session_id", "type": "string", "required": true},
        {"name": "user_text", "type": "string", "required": true},
        {"name": "session_context", "type": "string", "required": true},
        {"name": "skill_catalog", "type": "string", "required": true},
        {"name": "selected_skills", "type": "string", "required": true},
        {"name": "partial_skill_results", "type": "string"}
      ],
      "outputs": [
        {"name": "candidate_list", "type": "string"}
      ]
    },
    {
      "id": "finalizer_path",
      "name": "finalizer-selector",
      "type": "task",
      "execution_mode": "python_script",
      "command": "examples/agent/openjiuwen_multi_session_chat/nodes/python/select_skill_path_node.py",
      "args": ["coordinator", "finalizer"],
      "json_output": true,
      "inputs": [
        {"name": "session_id", "type": "string", "required": true},
        {"name": "user_text", "type": "string", "required": true},
        {"name": "session_context", "type": "string", "required": true},
        {"name": "skill_catalog", "type": "string", "required": true},
        {"name": "selected_skills", "type": "string", "required": true},
        {"name": "partial_skill_results", "type": "string"}
      ],
      "outputs": [
        {"name": "candidate_list", "type": "string"}
      ]
    },
    {
      "id": "merge_plan",
      "name": "merge-coordinator-candidates",
      "type": "task",
      "execution_mode": "python_script",
      "command": "examples/agent/openjiuwen_multi_session_chat/nodes/python/merge_coordinator_candidates_node.py",
      "json_output": true,
      "inputs": [
        {"name": "session_id", "type": "string", "required": true},
        {"name": "selected_skills", "type": "string", "required": true},
        {"name": "partial_skill_results", "type": "string"},
        {"name": "result_aware_candidates", "type": "string", "required": true},
        {"name": "dependency_candidates", "type": "string", "required": true},
        {"name": "finalizer_candidates", "type": "string", "required": true}
      ],
      "outputs": [
        {"name": "selected_skills", "type": "string"},
        {"name": "orchestration_plan", "type": "string"},
        {"name": "final_response", "type": "string"},
        {"name": "coordinator_done", "type": "bool"}
      ]
    }
  ],
  "edges": [
    {
      "id": "c1",
      "source": "load_context",
      "target": "result_aware_path",
      "source_outputs": ["session_context"],
      "target_inputs": ["session_context"],
      "transfer_mode": "value"
    },
    {
      "id": "c2",
      "source": "load_context",
      "target": "dependency_path",
      "source_outputs": ["session_context"],
      "target_inputs": ["session_context"],
      "transfer_mode": "value"
    },
    {
      "id": "c3",
      "source": "load_context",
      "target": "finalizer_path",
      "source_outputs": ["session_context"],
      "target_inputs": ["session_context"],
      "transfer_mode": "value"
    },
    {
      "id": "c4",
      "source": "build_catalog",
      "target": "result_aware_path",
      "source_outputs": ["skill_catalog"],
      "target_inputs": ["skill_catalog"],
      "transfer_mode": "value"
    },
    {
      "id": "c5",
      "source": "build_catalog",
      "target": "dependency_path",
      "source_outputs": ["skill_catalog"],
      "target_inputs": ["skill_catalog"],
      "transfer_mode": "value"
    },
    {
      "id": "c6",
      "source": "build_catalog",
      "target": "finalizer_path",
      "source_outputs": ["skill_catalog"],
      "target_inputs": ["skill_catalog"],
      "transfer_mode": "value"
    },
    {
      "id": "c7",
      "source": "result_aware_path",
      "target": "merge_plan",
      "source_outputs": ["candidate_list"],
      "target_inputs": ["result_aware_candidates"],
      "transfer_mode": "value"
    },
    {
      "id": "c8",
      "source": "dependency_path",
      "target": "merge_plan",
      "source_outputs": ["candidate_list"],
      "target_inputs": ["dependency_candidates"],
      "transfer_mode": "value"
    },
    {
      "id": "c9",
      "source": "finalizer_path",
      "target": "merge_plan",
      "source_outputs": ["candidate_list"],
      "target_inputs": ["finalizer_candidates"],
      "transfer_mode": "value"
    }
  ]
}
