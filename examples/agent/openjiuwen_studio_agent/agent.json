{
  "name": "OpenJiuwenStudioAgent",
  "version": "1.0.0",
  "description": "Coarse-grained agent-studio bundle integration example for AgentFlow",
  "session_pool_size": 1,
  "tasks": [
    {
      "id": 0,
      "type": "contextupdater",
      "description": "Summarize bundled Studio session context",
      "workflow_file": "context_workflow.json",
      "workflow_pool_size": 1,
      "scope": "agent"
    },
    {
      "id": 1,
      "type": "dispatcher",
      "description": "Dispatch user input into Studio adapter bundle",
      "workflow_file": "dispatcher_workflow.json",
      "workflow_pool_size": 2
    },
    {
      "id": 2,
      "type": "coordinator",
      "description": "Normalize Studio adapter responses",
      "workflow_file": "coordinator_workflow.json",
      "workflow_pool_size": 1
    },
    {
      "id": 3,
      "type": "skill",
      "description": "Wrapped Studio bundle skill task",
      "workflow_file": "studio_skill_workflow.json",
      "skill": {
        "name": "studio-bundle",
        "config_dir": "runtime",
        "instance_pool_size": 1
      },
      "workflow_pool_size": 1
    }
  ],
  "max_workflows": 8,
  "max_concurrent_workflows": 4
}