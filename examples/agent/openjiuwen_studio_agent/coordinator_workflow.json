{
  "id": "openjiuwen-studio-coordinator-workflow",
  "version": "1.0",
  "name": "OpenJiuwen Studio Coordinator",
  "description": "Default coordinator shell for bundled Studio output normalization",
  "nodes": [
    {
      "id": "studio_coordinate",
      "name": "Studio Coordinator Node",
      "type": "task",
      "execution_mode": "python_script",
      "command": "./nodes/python/studio_adapter_node.py",
      "args": ["--mode", "coordinator"],
      "json_output": true,
      "timeout_ms": 10000,
      "inputs": [
        {"name": "session_id", "type": "string", "required": true},
        {"name": "user_text", "type": "string", "required": true}
      ],
      "outputs": [
        {"name": "response", "type": "string"},
        {"name": "studio_trace", "type": "string"}
      ]
    }
  ],
  "edges": []
}
