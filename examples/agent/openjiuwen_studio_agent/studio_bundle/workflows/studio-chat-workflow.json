{
  "workflow_id": "studio-chat-workflow",
  "workflow_version": "0.1.0",
  "name": "Studio Chat Workflow",
  "schema": {
    "nodes": [
      {"id": "start", "type": "start", "name": "Start"},
      {"id": "planner", "type": "planner", "name": "Planner"},
      {"id": "responder", "type": "llm", "name": "Responder"},
      {"id": "memory_writer", "type": "memory", "name": "MemoryWriter"},
      {"id": "end", "type": "end", "name": "End"}
    ],
    "edges": [
      ["start", "planner"],
      ["planner", "responder"],
      ["responder", "memory_writer"],
      ["memory_writer", "end"]
    ]
  },
  "input_parameters": [
    {"name": "user_text", "type": "string", "required": true},
    {"name": "session_id", "type": "string", "required": true}
  ],
  "output_parameters": [
    {"name": "response", "type": "string"},
    {"name": "trace", "type": "object"}
  ],
  "_rest_": {
    "entry_workflow": true,
    "studio_canvas": "flowgram",
    "tool_groups": ["web-search", "task-planner"]
  }
}
