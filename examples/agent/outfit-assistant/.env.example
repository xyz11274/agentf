# AgentFlow — OutfitAssistant Agent 环境配置
# 复制此文件为 .env 并填入真实值
#   cp .env.example .env
# 在 run_agent.sh 启动前 source 加载（或 setup.sh 自动检测）

# ── LLM 配置（主模型）───────────────────────────────────────────
# agent.md 的 model 字段 > AF_LLM_MODEL > AF_FALLBACK_LLM_MODEL
# AF_LLM_API_KEY 优先，兜底 API_KEY，再兜底 AF_FALLBACK_LLM_API_KEY
AF_LLM_API_KEY="sk-your-primary-key-here"
AF_LLM_BASE_URL="https://api.openai.com/v1"
AF_LLM_MODEL="gpt-4o"

# ── LLM 降级配置（当主模型不可用时的备选）────────────────────
# Bridge 在 load_agent 时会自动注入此组配置。
# 节点读取逻辑：先读 AF_LLM_*，若缺失/占位符则读 AF_FALLBACK_LLM_*
AF_FALLBACK_LLM_API_KEY=""
AF_FALLBACK_LLM_BASE_URL="https://api.minimax.io/v1"
AF_FALLBACK_LLM_MODEL="MiniMax-M3"

# ── Coordinator 迭代限制 ─────────────────────────────────────────
# 最大协调轮次（每轮包含一次 LLM 决策 + skill 执行 + 结果评估）
# 当轮次耗尽时强制输出最终结果（注入 <system-reminder>）
# AF_MAX_COORDINATOR_ITERATIONS=10

# ── Skill 迭代限制 ──────────────────────────────────────────────
# 最大 skill 内部 LLM 循环轮次（兼容旧名 AF_SKILL_MAX_ROUNDS）
# AF_MAX_SKILL_TASK_ITERATIONS=8

# ── Token 预算与上下文压缩 ──────────────────────────────────────
# 模型上下文窗口上限（token），用于消息压缩计算
# AF_MODEL_MAX_TOKENS=128000

# 压缩触发阈值 (0.0-1.0)
# 当消息列表预估 tokens > AF_MODEL_MAX_TOKENS * AF_COMPACTION_THRESHOLD 时，
# 自动剔除早期非 system 消息，确保清单低于该阈值
# AF_COMPACTION_THRESHOLD=0.8

# ── 关键业务配置 ────────────────────────────────────────────────
# outfit-stylist skill 需要和风天气 API
# QWEATHER_API_KEY="your-qweather-key"
# QWEATHER_API_HOST="https://devapi.qweather.com"
# DASHSCOPE_VL_MODEL=qwen-vl-max

# ── LLM 请求调优 ────────────────────────────────────────────────
# 最大输出 token（coordinator 默认 8192；skill 单独 AF_SKILL_MAX_COMPLETION_TOKENS）
# AF_MAX_COMPLETION_TOKENS=8192

# HTTP 传输调优
# AF_LLM_TIMEOUT=120               # 总超时（秒）
# AF_LLM_CONNECT_TIMEOUT=5          # 连接超时（秒）
# AF_LLM_MAX_RETRIES=2              # 网络重试次数
# AF_LLM_RETRY_BASE_DELAY=1.0       # 重试初始间隔（秒）

# 节点执行超时（skill executor/coordinator 单次节点最长运行时间）
# AF_NODE_EXECUTION_TIMEOUT=240

# ── VL（Vision-Language）多模态模型配置 ─────────────────────────
# understand_image 工具使用此配置。
# 优先级链：VISION_API_KEY > API_KEY > VISION_FALLBACK_API_KEY
#          VISION_BASE_URL > VISION_FALLBACK_BASE_URL
#          VISION_MODEL > VISION_FALLBACK_MODEL
VISION_BASE_URL="https://api.minimax.io/v1/chat/completions"
VISION_MODEL="MiniMax-M3"
VISION_API_KEY=""

# ── VL 降级配置 ──────────────────────────────────────────────────
# 当上述 VISION_* 均不可用时使用
VISION_FALLBACK_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions"
VISION_FALLBACK_MODEL="qwen-vl-max"
VISION_FALLBACK_API_KEY=""
