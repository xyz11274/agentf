# OutfitAssistant 环境变量配置
# 用法：cp .env.example .env，然后填入真实值
# 启动时：set -a; . .env; set +a

# ── LLM API ──
# 必填。LLM API key（OpenAI 兼容接口）
API_KEY=sk-cp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选。LLM API base URL，覆盖 agent.md 里的 model.base_url
AF_LLM_BASE_URL=https://api.minimaxi.com/v1

# 可选。LLM 模型名，覆盖 agent.md 里的 model.name
AF_LLM_MODEL=Minimax-M3

# ── 和风天气 API（weather_query skill 需要）──
# 必填。和风天气 API key，申请：https://dev.qweather.com/
QWEATHER_API_KEY=your_qweather_api_key_here

# 必填。和风天气 API host（如免费订阅：xxx.re.qweatherapi.com）
QWEATHER_API_HOST=your_host.re.qweatherapi.com
