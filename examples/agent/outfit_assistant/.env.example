# AgentFlow — OutfitAssistant Agent 环境配置
# 复制此文件为 .env 并填入真实值
#   cp .env.example .env
# 在 run_agent.sh 启动前 source 加载（或 setup.sh 自动检测）

# ── LLM 配置（必填）─────────────────────────────────────────────
# API Key（优先 AF_LLM_API_KEY，fallback API_KEY）
# AF_LLM_API_KEY="sk-your-api-key-here"
# API_KEY="sk-your-api-key-here"

# API 地址（可选，覆盖 agent.md 的 model 配置）
# AF_LLM_BASE_URL="https://api.openai.com/v1"

# 模型名（可选，覆盖 agent.md frontmatter model）
# AF_LLM_MODEL="gpt-4o-mini"

# ── Coordinator 迭代限制 ─────────────────────────────────────────
# 最大协调轮次（每轮包含一次 LLM 决策 + skill 执行 + 结果评估）
# 当轮次耗尽时强制输出最终结果（注入 <system-reminder>）
# AF_MAX_COORDINATOR_ITERATIONS=10

# ── Skill 迭代限制 ──────────────────────────────────────────────
# 最大 skill 内部 LLM 循环轮次（兼容旧名 AF_SKILL_MAX_ROUNDS）
# AF_MAX_SKILL_TASK_ITERATIONS=8

# ── Token 预算与上下文压缩 ──────────────────────────────────────
# 模型上下文窗口上限（token），用于消息压缩计算
# AF_MODEL_MAX_TOKENS=128000

# 压缩触发阈值 (0.0-1.0)
# 当消息列表预估 tokens > AF_MODEL_MAX_TOKENS * AF_COMPACTION_THRESHOLD 时，
# 自动剔除早期非 system 消息，确保清单低于该阈值
# AF_COMPACTION_THRESHOLD=0.8

# ── 关键业务配置 ────────────────────────────────────────────────
# outfit-stylist skill 需要和风天气 API
# QWEATHER_API_KEY="your-qweather-key"
# QWEATHER_API_HOST="https://devapi.qweather.com"

# ── LLM 请求调优（可选）─────────────────────────────────────────
# 最大输出 token（coordinator 默认 8192；skill 单独 AF_SKILL_MAX_COMPLETION_TOKENS）
# AF_MAX_COMPLETION_TOKENS=8192

# HTTP 传输调优
# AF_LLM_TIMEOUT=120               # 总超时（秒）
# AF_LLM_CONNECT_TIMEOUT=5          # 连接超时（秒）
# AF_LLM_MAX_RETRIES=2              # 网络重试次数
# AF_LLM_RETRY_BASE_DELAY=1.0       # 重试初始间隔（秒）

# ── VL（Vision-Language）多模态模型配置 ─────────────────────────
# understand_image 工具使用此配置调用多模态模型理解图片。
# 格式：OpenAI-compatible chat completions 接口。
# 必填三项，否则工具调用时会明确报错告知缺少哪项。
#
# VISION_BASE_URL  VL 模型 API 地址
#                   示例:
#                     MiniMax-M3:  https://api.minimax.io/v1/chat/completions
#                     通义千问 VL: https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
#                     GPT-4o:      https://api.openai.com/v1/chat/completions
# VISION_MODEL     模型名，如 MiniMax-M3 / qwen-vl-max / gpt-4o
# VISION_API_KEY   VL 模型专用 Key（可选，默认复用 API_KEY / MINIMAX_API_KEY）
#
# VISION_BASE_URL="https://api.minimax.io/v1/chat/completions"
# VISION_MODEL="MiniMax-M3"
# VISION_API_KEY="sk-..."
