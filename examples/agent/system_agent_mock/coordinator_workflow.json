{
  "id": "coordinator-workflow",
  "version": "1.0",
  "name": "Custom Coordinator Workflow",
  "nodes": [
    {
      "id": "aggregate_results",
      "name": "Aggregate Skill Results",
      "type": "task",
      "execution_mode": "so_library",
      "command": "lib/libcoordinator_node.so",
      "function_name": "coordinator_node",
      "inputs": [
        {"name": "session_id", "type": "string", "required": true},
        {"name": "user_text", "type": "string", "required": true},
        {"name": "dialogue_id", "type": "string", "required": false}
      ],
      "outputs": [
        {"name": "response", "type": "string"},
        {"name": "final_answer", "type": "string"},
        {"name": "coordinator_done", "type": "bool"}
      ],
      "timeout_ms": 10000
    }
  ],
  "edges": []
}