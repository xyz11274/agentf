{
  "id": "travel-workflow",
  "version": "1.0",
  "name": "Travel Skill Workflow",
  "nodes": [
    {
      "id": "travel_node",
      "name": "Travel Mock Skill",
      "type": "task",
      "execution_mode": "so_library",
      "command": "lib/libtravel_node.so",
      "function_name": "travel_node",
      "inputs": [
        {"name": "user_text", "type": "string", "required": true},
        {"name": "session_id", "type": "string", "required": true},
        {"name": "dialogue_id", "type": "string", "required": false}
      ],
      "outputs": [
        {"name": "skill_result", "type": "string"},
        {"name": "status", "type": "string"},
        {"name": "confidence", "type": "double"}
      ],
      "timeout_ms": 5000
    }
  ],
  "edges": []
}