# Harness Agent 环境变量配置
# 用法：cp .env.example .env，然后填入真实值
# 启动时：set -a; . .env; set +a

# ── LLM API ──
# 必填。LLM API key（OpenAI 兼容接口）
API_KEY=sk-your-api-key-here

# 主问答模型 LLM API base URL
AF_LLM_BASE_URL=https://api.openai.com/v1


# 可选。LLM 模型名，覆盖 agent.md 里的 model.name
# AF_LLM_MODEL=gpt-4o-mini


# ── Coordinator 迭代限制 ──
# 最大协调轮次
# AF_MAX_COORDINATOR_ITERATIONS=10

# ── Skill 迭代限制 ──
# 最大 skill 内部 LLM 循环轮次（兼容旧名 AF_SKILL_MAX_ROUNDS）
# AF_MAX_SKILL_TASK_ITERATIONS=8

# ── Token 预算与上下文压缩 ──
# 模型上下文窗口上限（token），用于消息压缩计算
# AF_MODEL_MAX_TOKENS=128000

# 压缩触发阈值 (0.0-1.0)
# AF_COMPACTION_THRESHOLD=0.8

# ── LLM 请求调优（可选）─
# 最大输出 token（coordinator 默认 8192；skill 单独 AF_SKILL_MAX_COMPLETION_TOKENS）
# AF_MAX_COMPLETION_TOKENS=8192

# HTTP 传输调优
# AF_LLM_TIMEOUT=120
# AF_LLM_CONNECT_TIMEOUT=5
# AF_LLM_MAX_RETRIES=2
# AF_LLM_RETRY_BASE_DELAY=1.0

# ── VL（Vision-Language）多模态模型配置 ──
# understand_image 工具使用此配置调用多模态模型理解图片。
# VISION_BASE_URL  VL 模型 API 地址
# VISION_MODEL     模型名
# VISION_API_KEY   VL 模型专用 Key（可选，默认复用 API_KEY）
# VISION_BASE_URL="https://api.openai.com/v1/chat/completions"
# VISION_MODEL="gpt-4o"
# VISION_API_KEY="sk-..."
