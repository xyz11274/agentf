{
  "name": "WorkflowPatternsAgent",
  "version": "1.0.0",
  "description": "Agent demonstrating common workflow patterns: conditional branching, switch-case routing, and sequential processing",
  "session_pool_size": 1,
  "tasks": [
    {
      "id": 0,
      "type": "contextupdater",
      "description": "Update workflow-pattern context",
      "workflow_file": "loop_workflow.json",
      "workflow_pool_size": 2,
      "scope": "agent"
    },
    {
      "id": 0,
      "type": "dispatcher",
      "description": "Dispatch workflow pattern requests",
      "workflow_file": "sample_workflow.json",
      "workflow_pool_size": 3
    },
    {
      "id": 1,
      "type": "coordinator",
      "description": "Coordinate workflow pattern outputs",
      "workflow_file": "conditional_workflow.json",
      "workflow_pool_size": 2
    },
    {
      "id": 2,
      "type": "skill",
      "description": "Run switch-case routing skill",
      "workflow_file": "loop_workflow.json",
      "skill": {
        "name": "switch-router",
        "config_dir": "skills/switch-router",
        "instance_pool_size": 2
      },
      "workflow_pool_size": 2
    }
  ],
  "max_workflows": 10,
  "max_concurrent_workflows": 5
}