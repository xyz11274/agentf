{
  "workflow": {
    "id": "routing-workflow-001",
    "name": "Switch Routing Workflow",
    "version": "1.0.0",
    "description": "A workflow demonstrating switch-case style routing with typed node IO",
    "nodes": [
      {
        "id": "node-load",
        "name": "Load Request",
        "type": "loader",
        "execution_mode": "cpp_function",
        "outputs": [
          {"name": "route", "type": "string"},
          {"name": "payload", "type": "map", "transfer_mode": "ref"}
        ]
      },
      {
        "id": "node-process-a",
        "name": "Process Route A",
        "type": "processor",
        "execution_mode": "cpp_function",
        "inputs": [
          {"name": "payload", "type": "map", "transfer_mode": "ref"}
        ],
        "outputs": [
          {"name": "result_a", "type": "string"}
        ]
      },
      {
        "id": "node-process-b",
        "name": "Process Route B",
        "type": "processor",
        "execution_mode": "cpp_function",
        "inputs": [
          {"name": "payload", "type": "map", "transfer_mode": "ref"}
        ],
        "outputs": [
          {"name": "result_b", "type": "string"}
        ]
      },
      {
        "id": "node-fallback",
        "name": "Fallback Route",
        "type": "processor",
        "execution_mode": "cpp_function",
        "inputs": [
          {"name": "payload", "type": "map", "transfer_mode": "ref"}
        ],
        "outputs": [
          {"name": "fallback_result", "type": "string"}
        ]
      }
    ],
    "edges": [
      {
        "id": "edge-load-process-a",
        "source": "node-load",
        "target": "node-process-a",
        "source_outputs": ["payload"],
        "target_inputs": ["payload"],
        "transfer_mode": "ref",
        "control": {"type": "switch-case", "expression": "route", "case_value": "A"}
      },
      {
        "id": "edge-load-process-b",
        "source": "node-load",
        "target": "node-process-b",
        "source_outputs": ["payload"],
        "target_inputs": ["payload"],
        "transfer_mode": "ref",
        "control": {"type": "switch-case", "expression": "route", "case_value": "B"}
      },
      {
        "id": "edge-load-fallback",
        "source": "node-load",
        "target": "node-fallback",
        "source_outputs": ["payload"],
        "target_inputs": ["payload"],
        "transfer_mode": "ref",
        "control": {"type": "switch-case", "expression": "route", "is_default": true}
      }
    ]
  }
}
