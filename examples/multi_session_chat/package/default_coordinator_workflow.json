{
  "id": "default-coordinator-workflow",
  "version": "1.0",
  "name": "default-coordinator-workflow",
  "nodes": [
    {
      "id": "collect",
      "name": "collect-selected-skills",
      "type": "task",
      "execution_mode": "so_library",
      "command": "build/libmulti_session_nodes.dylib",
      "function_name": "node_collect_skills",
      "inputs": ["session_ids"],
      "outputs": ["selected_skills"]
    },
    {
      "id": "plan",
      "name": "llm-plan-dependencies",
      "type": "task",
      "execution_mode": "so_library",
      "command": "build/libmulti_session_nodes.dylib",
      "function_name": "node_plan_dependencies",
      "inputs": ["selected_skills"],
      "outputs": ["task_plan"]
    },
    {
      "id": "apply",
      "name": "apply-task-status",
      "type": "task",
      "execution_mode": "so_library",
      "command": "build/libmulti_session_nodes.dylib",
      "function_name": "node_apply_task_plan",
      "inputs": ["task_plan", "selected_skills"],
      "outputs": ["orchestration_plan"]
    }
  ],
  "edges": [
    {"id": "c1", "source": "collect", "target": "plan"},
    {"id": "c2", "source": "plan", "target": "apply"}
  ]
}
