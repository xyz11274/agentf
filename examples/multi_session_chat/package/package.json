    "skill_search": "skill-search-workflow",
    "skill_summary": "skill-summary-workflow",
    "skill_date": "skill-date-workflow",
    "skill_delegate": "skill-delegate-workflow"
  },
  "session_context_workflow": "session-context-workflow",
  "metadata": {
