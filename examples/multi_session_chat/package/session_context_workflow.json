{
  "id": "session-context-workflow",
  "version": "1.0",
  "name": "session-context-workflow",
  "nodes": [
    {
      "id": "read_prompt",
      "name": "read-prompt-template",
      "type": "task",
      "execution_mode": "go_script",
      "command": "examples/multi_session_chat/nodes/go/session_context/main.go",
      "args": ["read_prompt"],
      "json_output": true,
      "outputs": ["prompt_template"]
    },
    {
      "id": "read_history",
      "name": "read-dialog-history",
      "type": "task",
      "execution_mode": "go_script",
      "command": "examples/multi_session_chat/nodes/go/session_context/main.go",
      "args": ["read_history"],
      "json_output": true,
      "inputs": ["session_id"],
      "outputs": ["history_tail"]
    },
    {
      "id": "summarize",
      "name": "summarize-history-via-llm",
      "type": "task",
      "execution_mode": "go_script",
      "command": "examples/multi_session_chat/nodes/go/session_context/main.go",
      "args": ["summarize"],
      "json_output": true,
      "inputs": ["prompt_template", "history_tail"],
      "outputs": ["history_summary"]
    },
    {
      "id": "fill_context",
      "name": "fill-context",
      "type": "task",
      "execution_mode": "go_script",
      "command": "examples/multi_session_chat/nodes/go/session_context/main.go",
      "args": ["fill_context"],
      "json_output": true,
      "inputs": ["session_id", "history_summary"],
      "outputs": ["session_context"]
    }
  ],
  "edges": [
    {"id": "s1", "source": "read_prompt", "target": "read_history"},
    {"id": "s2", "source": "read_history", "target": "summarize"},
    {"id": "s3", "source": "summarize", "target": "fill_context"}
  ]
}
