{
  "id": "session-coordinator-workflow",
  "version": "1.0",
  "name": "session-coordinator-workflow",
  "nodes": [
    {
      "id": "collect",
      "name": "collect-selected-skills",
      "type": "task",
      "execution_mode": "so_library",
      "command": "build/libmulti_session_nodes.dylib",
      "function_name": "node_collect_skills",
      "inputs": [
        {"name": "session_ids", "type": "list", "required": true}
      ],
      "outputs": [
        {"name": "selected_skills", "type": "string"}
      ]
    },
    {
      "id": "plan",
      "name": "llm-plan-dependencies",
      "type": "task",
      "execution_mode": "so_library",
      "command": "build/libmulti_session_nodes.dylib",
      "function_name": "node_plan_dependencies",
      "inputs": [
        {"name": "selected_skills", "type": "string", "required": true}
      ],
      "outputs": [
        {"name": "task_plan", "type": "string"}
      ]
    },
    {
      "id": "apply",
      "name": "apply-task-status",
      "type": "task",
      "execution_mode": "so_library",
      "command": "build/libmulti_session_nodes.dylib",
      "function_name": "node_apply_task_plan",
      "inputs": [
        {"name": "task_plan", "type": "string", "required": true},
        {"name": "selected_skills", "type": "string", "required": true}
      ],
      "outputs": [
        {"name": "orchestration_plan", "type": "string"}
      ]
    }
  ],
  "edges": [
    {
      "id": "c1",
      "source": "collect",
      "target": "plan",
      "source_outputs": ["selected_skills"],
      "target_inputs": ["selected_skills"],
      "transfer_mode": "value"
    },
    {
      "id": "c2",
      "source": "plan",
      "target": "apply",
      "source_outputs": ["task_plan"],
      "target_inputs": ["task_plan"],
      "transfer_mode": "value"
    }
  ]
}
