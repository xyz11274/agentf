{
  "id": "skill-delegate-workflow",
  "version": "1.0",
  "name": "skill-delegate-workflow",
  "nodes": [
    {
      "id": "n1",
      "name": "agent-delegate",
      "type": "task",
      "execution_mode": "java_jar",
      "command": "examples/multi_session_chat/nodes/java/skill_delegate.jar",
      "main_class": "SkillDelegateNode",
      "json_output": true,
      "enable_hot_reload": false,
      "inputs": [
        {"name": "user_text", "type": "string", "required": true},
        {"name": "session_id", "type": "string", "required": true}
      ],
      "outputs": [
        {"name": "delegate_result", "type": "string"}
      ]
    }
  ],
  "edges": []
}
