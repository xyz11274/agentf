# ============================================================================
# AgentFlow Bridge — Configuration Template
# ============================================================================
# Copy this file to .env and modify for your environment:
#   cp .env.example .env
#
# Environment variables override .env values. The .env file is NOT committed.
# Reading order: code defaults < .env file < system environment variables
# ============================================================================

# --- 🔌 daemon connectivity ------------------------------------------------
# Hostname or IP of the agentflowd daemon.
DAEMON_HOST=localhost
# TCP / WebSocket port of the daemon (1-65535).
DAEMON_PORT=17891

# --- 🌐 bridge server bind -------------------------------------------------
# FastAPI bind address. Use "127.0.0.1" for local-only access.
BRIDGE_HOST=0.0.0.0
# FastAPI bind port (1-65535).
BRIDGE_PORT=8199

# --- 📂 filesystem paths ---------------------------------------------------
# Agent Package source trees directory.
# Relative paths are resolved against the project root (parent of frontend/bridge/).
AGENT_PACKAGES_DIR=examples/agent
# Skill Hub central repository directory.
SKILL_HUB_DIR=resource/skill_hub

# --- 🪵 logging ------------------------------------------------------------
# Python logging level name.
# Valid: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- 🚦 timeouts & intervals -----------------------------------------------
# Per-request timeout for outbound daemon JSON-RPC calls (seconds, > 0).
REQUEST_TIMEOUT_SECONDS=5.0
# Background daemon status cache refresh interval (seconds, > 0).
DAEMON_STATUS_REFRESH_INTERVAL=10.0

# --- 🌍 CORS ---------------------------------------------------------------
# Origins allowed by CORS middleware.
# JSON array of strings. Default allows the Vite dev server on both loopback
# aliases so that ``npm run dev`` works out of the box.
CORS_ALLOWED_ORIGINS=["http://localhost:15173","http://127.0.0.1:15173"]
