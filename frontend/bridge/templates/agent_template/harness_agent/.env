# API Keys
# bailian 
AF_LLM_API_KEY=
DASHSCOPE_API_KEY=
# 非标准凭据变量名用逗号登记，例：VENDOR_HANDLE,PRIVATE_SESSION
AF_SECRET_ENV_NAMES=


# LLM Configuration (optional, overrides agent.md)
AF_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AF_LLM_MODEL=Qwen3-32b

# For Skills
DASHSCOPE_VL_MODEL=aisf/qwen-vl-max


AF_MAX_SKILL_TASK_ITERATIONS=20
AF_SKILL_MAX_COMPLETION_TOKENS=8192
AF_MAX_COMPLETION_TOKENS=8192 # typically for coordinator
AF_SKILL_LLM_RECOVERY_ATTEMPTS=2

# ── VL (Vision-Language) 多模态模型配置 ──────────────────────────
# understand_image 工具使用此配置
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3-vl-flash
