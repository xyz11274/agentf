# OutfitAssistant 环境变量配置
# 用法：cp .env.example .env，然后填入真实值
# 启动时：set -a; . .env; set +a

# ── LLM API ──
# 必填。LLM API key（OpenAI 兼容接口）
API_KEY=sk-cp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 主问答模型LLM API base URL
AF_LLM_BASE_URL=https://xxx/v1


# 可选。LLM 模型名，覆盖 agent.md 里的 model.name
AF_LLM_MODEL=MiniMax-M3
# AF_LLM_MODEL=Qwen3-32b



# ── Skill 执行控制 ──
# 单个 skill 最多允许的 LLM 调用轮数
AF_SKILL_MAX_ROUNDS=20

# 每次 LLM 调用的最大输出 token 数（包含推理、正文和工具调用参数，不包含输入）
AF_SKILL_MAX_COMPLETION_TOKENS=8192

AF_MAX_COMPLETION_TOKENS=8192 # typically for coordinator

# LLM 超时、非法工具参数或输出截断时的自动恢复次数
AF_SKILL_LLM_RECOVERY_ATTEMPTS=2
