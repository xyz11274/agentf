{
  "id": "coordinator-workflow",
  "version": "3.0",
  "name": "Coordinator Loop",
  "nodes": [
    {
      "id": "coordinator_decide",
      "name": "Coordinator Decide",
      "type": "task",
      "execution_mode": "shell_script",
      "command": "bash nodes/coordinator_decide.sh",
      "working_dir": "examples/agent/harness-agent",
      "json_output": true,
      "enable_hot_reload": false,
      "inputs": [
        {
          "name": "input",
          "type": "string",
          "required": true
        },
        {
          "name": "session_id",
          "type": "string",
          "required": true
        },
        {
          "name": "dialogue_id",
          "type": "string",
          "required": false
        },
        {
          "name": "completed_skill_name",
          "type": "string",
          "required": false
        },
        {
          "name": "skill_success",
          "type": "string",
          "required": false
        },
        {
          "name": "skill_result",
          "type": "string",
          "required": false
        },
        {
          "name": "skill_artifacts",
          "type": "string",
          "required": false
        }
      ],
      "outputs": [
        {
          "name": "response",
          "type": "string"
        },
        {
          "name": "next_skills",
          "type": "string"
        },
        {
          "name": "coordinator_status",
          "type": "string"
        }
      ],
      "timeout_ms": 900000
    }
  ],
  "edges": []
}
