{
  "id": "coremind-context-workflow",
  "version": "1.0",
  "name": "CoreMind Context Workflow",
  "nodes": [
    {
      "id": "context_echo",
      "name": "Context Echo Node",
      "type": "task",
      "execution_mode": "python_script",
      "command": "context_node.py",
      "working_dir": "frontend/bridge/tests/fixtures/coremind_context_agent",
      "inputs": [
        {"name": "input", "type": "string", "required": true},
        {"name": "platform_context", "type": "string", "required": true},
        {"name": "request_id", "type": "string", "required": true}
      ],
      "outputs": [{"name": "response", "type": "string"}],
      "json_output": true,
      "timeout_ms": 10000
    }
  ],
  "edges": []
}
