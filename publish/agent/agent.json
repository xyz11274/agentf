{
  "name": "SampleAgent",
  "version": "1.0.0",
  "description": "Sample Agent package template",
  "session_pool_size": 2,
  "tasks": [
    {
      "id": 0,
      "type": "contextupdater",
      "scope": "agent",
      "description": "Update agent-level context",
      "workflow_file": "workflow_01.json",
      "workflow_pool_size": 2
    },
    {
      "id": 1,
      "type": "dispatcher",
      "description": "Dispatch user requests",
      "workflow_file": "workflow_01.json",
      "workflow_pool_size": 3
    },
    {
      "id": 2,
      "type": "coordinator",
      "description": "Coordinate task outputs",
      "workflow_file": "coordinator_workflow.json",
      "workflow_pool_size": 2
    },
    {
      "id": 3,
      "type": "skill",
      "description": "Run knowledge skill workflow",
      "workflow_file": "workflow_knowledge.json",
      "skill": {
        "name": "knowledge",
        "instance_pool_size": 2
      },
      "workflow_pool_size": 2
    },
    {
      "id": 4,
      "type": "skill",
      "description": "Run tools skill workflow",
      "workflow_file": "workflow_tools.json",
      "skill": {
        "name": "tools",
        "instance_pool_size": 2
      },
      "workflow_pool_size": 2
    }
  ],
  "max_workflows": 10,
  "max_concurrent_workflows": 5
}