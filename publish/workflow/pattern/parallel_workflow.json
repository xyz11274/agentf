{
  "id": "parallel-workflow-pattern",
  "version": "1.0",
  "name": "parallel-workflow-pattern",
  "description": "start -> tool_select -> (tool_exec_a || tool_exec_b) -> end",
  "nodes": [
    {"id": "start", "type": "start", "execution_mode": "cpp_function"},
    {"id": "tool_select", "type": "task", "execution_mode": "shell_script", "command": "nodes/tool_select.sh"},
    {"id": "tool_exec_a", "type": "task", "execution_mode": "shell_script", "command": "nodes/tool_call.sh"},
    {"id": "tool_exec_b", "type": "task", "execution_mode": "shell_script", "command": "nodes/tool_call.sh"},
    {"id": "end", "type": "end", "execution_mode": "cpp_function"}
  ],
  "edges": [
    {"id": "e_start_select", "source": "start", "target": "tool_select", "control": {"type": "if", "expression": "true"}},
    {"id": "e_select_a", "source": "tool_select", "target": "tool_exec_a", "control": {"type": "fork", "fork_group": "tool_exec"}},
    {"id": "e_select_b", "source": "tool_select", "target": "tool_exec_b", "control": {"type": "fork", "fork_group": "tool_exec"}},
    {"id": "e_a_end", "source": "tool_exec_a", "target": "end", "control": {"type": "join", "join_group": "tool_exec"}},
    {"id": "e_b_end", "source": "tool_exec_b", "target": "end", "control": {"type": "join", "join_group": "tool_exec"}}
  ]
}
