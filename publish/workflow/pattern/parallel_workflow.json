{
  "id": "parallel-workflow-pattern",
  "version": "1.0",
  "name": "parallel-workflow-pattern",
  "description": "start -> tool_select -> tool_exec_a/tool_exec_b -> end",
  "nodes": [
    {"id": "start", "name": "Start", "type": "start", "execution_mode": "cpp_function"},
    {"id": "tool_select", "name": "Tool Select", "type": "task", "execution_mode": "shell_script", "command": "nodes/tool_select.sh"},
    {"id": "tool_exec_a", "name": "Tool Execute A", "type": "task", "execution_mode": "shell_script", "command": "nodes/tool_call.sh"},
    {"id": "tool_exec_b", "name": "Tool Execute B", "type": "task", "execution_mode": "shell_script", "command": "nodes/tool_call.sh"},
    {"id": "end", "name": "End", "type": "end", "execution_mode": "cpp_function"}
  ],
  "edges": [
    {"id": "e_start_select", "source": "start", "target": "tool_select"},
    {"id": "e_select_a", "source": "tool_select", "target": "tool_exec_a"},
    {"id": "e_select_b", "source": "tool_select", "target": "tool_exec_b"},
    {"id": "e_a_end", "source": "tool_exec_a", "target": "end"},
    {"id": "e_b_end", "source": "tool_exec_b", "target": "end"}
  ]
}
