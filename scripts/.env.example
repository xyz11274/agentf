# AgentFlow 本地/生产部署配置
# 复制此文件为 .env 并填入真实值
#    cp ar_scripts/.env.example ar_scripts/.env
# 在 ar_scripts/ 目录下执行 run_agent.sh 会自动加载

# LLM API 地址（必填）
# AF_LLM_BASE_URL="https://api.openai.com/v1"

# LLM API 密钥（必填）
# AF_LLM_API_KEY="sk-your-api-key-here"

# LLM 模型名（可选，默认 gpt-4o-mini）
# AF_LLM_MODEL="gpt-4o-mini"

# LLM 超时与重试（可选）
# AF_LLM_TIMEOUT=120           # 请求总超时（秒，默认 120）
# AF_LLM_CONNECT_TIMEOUT=10    # TCP 连接超时（秒，默认 5）
# AF_LLM_MAX_RETRIES=2         # 网络错误重试次数（默认 0=不重试）
# AF_LLM_RETRY_BASE_DELAY=1.0  # 重试退避基数（秒，默认 1.0）

# UDS 通道切换（可选）
# 设为 true 后所有 LLM 调用走 UDS 而非 HTTP，无需修改代码
# AF_USE_AISF_MODELS=true

# SideCar → Bridge 内部请求凭据（生产必填）
# AISF_INTERNAL_TOKEN="replace-with-deployment-secret"

# CoreMind 服务发现白名单，逗号分隔
# COREMIND_REQUIRED_SERVICES="IMInferScheduler"
# COREMIND_OPTIONAL_SERVICES="DMContextService,KMMService"

# 生产启动参数
# AGENT_PACKAGE="examples/agent/outfit-assistant"
# DAEMON_PORT="17891"
# PYTHON_BRIDGE_PORT="8199"
# COREMIND_BRIDGE_PORT="23767"
