# AgentFlow Agent Dockerfile
#
# Lightweight image for distributed execution agents

FROM ubuntu:22.04

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    libssl3 \
    libevent-2.1-7 \
    libprotobuf23 \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -r -s /bin/false agentflow

WORKDIR /app

# Copy agent binary (to be built separately)
COPY build/agentflow_agent /app/bin/ 2>/dev/null || true

# Copy libraries
COPY build/libagentflow.a /app/lib/ 2>/dev/null || true

# Create directories
RUN mkdir -p /app/data /app/logs && chown -R agentflow:agentflow /app

USER agentflow

# Expose port for agent communication
EXPOSE 50052

# Environment variables
ENV AGENTFLOW_MASTER_ADDR=agentflow-server:50051
ENV AGENTFLOW_AGENT_ID=""

# Entry point
ENTRYPOINT ["/app/bin/agentflow_agent"]
CMD ["--master", "${AGENTFLOW_MASTER_ADDR}"]
