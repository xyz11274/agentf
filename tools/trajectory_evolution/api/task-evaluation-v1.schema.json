{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trajectory-evolution:task-evaluation:v1",
  "title": "Language-neutral offline evaluation host request or response",
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/response"}],
  "$defs": {
    "identity": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_steps", "max_tool_calls", "timeout_ms"],
      "properties": {
        "max_steps": {"type": "integer", "minimum": 1, "maximum": 10000},
        "max_tool_calls": {"type": "integer", "minimum": 1, "maximum": 100000},
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 86400000}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "trial_id", "variant_id", "repetition", "task"],
      "properties": {
        "schema_version": {"const": 1}, "trial_id": {"$ref": "#/$defs/identity"},
        "variant_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "pattern": "^agent-version-v1:[0-9a-f]{64}$"},
        "artifact": {"type": "object"},
        "evaluation_mode": {"const": true},
        "repetition": {"type": "integer", "minimum": 1, "maximum": 100},
        "task": {
          "type": "object", "additionalProperties": false,
          "required": ["task_id", "task_input", "followup_inputs", "initial_state", "constraints", "budget"],
          "properties": {
            "task_id": {"type": "string"}, "task_input": {"type": "string"},
            "followup_inputs": {"type": "array", "maxItems": 32, "items": {"type": "string"}},
            "initial_state": {"type": "object"},
            "constraints": {"type": "array", "maxItems": 64, "items": {"type": "string"}},
            "budget": {"$ref": "#/$defs/budget"}
          }
        }
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "trial_id", "execution_status", "output"],
      "properties": {
        "schema_version": {"const": 1}, "trial_id": {"$ref": "#/$defs/identity"},
        "execution_status": {"enum": ["completed", "failed", "cancelled", "environment_error"]},
        "loaded_version": {"type": "string"},
        "output": true, "state": {"type": "object"},
        "metrics": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "steps": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "tool_calls": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "loop_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "llm_calls": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "input_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "output_tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "tokens": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
          }
        },
        "trace": {"type": "object", "$comment": "Must satisfy the trajectory.v1 Protobuf contract and causal validator."},
        "traces": {"type": "array", "minItems": 1, "maxItems": 1024, "items": {"type": "object"},
          "$comment": "Ordered real runs for a multi-turn task. Mutually exclusive with trace; each run must satisfy trajectory.v1."},
        "artifacts": {
          "type": "array", "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["path"],
            "properties": {
              "path": {"type": "string", "minLength": 1, "maxLength": 1024},
              "media_type": {"type": "string"}
            }
          }
        }
      }
    }
  },
  "$comment": "The host is trusted test infrastructure; never expose fixture instructions or grading criteria to the tested model. C++ additionally validates privacy, budgets, paths and trace/output consistency. State and metrics must be observed, not model self-scores. JSON Schema is not an execution sandbox."
}
