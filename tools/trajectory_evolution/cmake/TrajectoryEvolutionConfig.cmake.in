@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(CURL)
find_dependency(OpenSSL COMPONENTS Crypto)
find_package(Protobuf CONFIG QUIET)
if(NOT Protobuf_FOUND)
  find_dependency(Protobuf)
endif()
find_dependency(Threads)
if(@PNG_FOUND@)
  find_dependency(PNG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/TrajectoryEvolutionTargets.cmake")
set(TrajectoryEvolution_CONFIG_DIR
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/trajectory_evolution/config")
check_required_components(TrajectoryEvolution)
