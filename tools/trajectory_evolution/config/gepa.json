{
  "schema_version": 1,
  "runtime_config": "runtime.json",
  "prompt_file": "prompts/gepa-reflection.txt",
  "max_rounds": 8,
  "max_model_calls": 8,
  "max_trials": 400,
  "timeout_ms": 1800000,
  "minibatch_size": 4,
  "max_feedback_trials": 4,
  "max_input_bytes": 65536,
  "max_experience_bytes": 2048,
  "patience": 4,
  "seed": 42,
  "min_improvement": 0.000001,
  "use_merge": true,
  "max_merge_invocations": 5,
  "merge_minibatch_size": 4,
  "candidate_selection_strategy": "pareto",
  "frontier_type": "instance",
  "prune_dominated": true,
  "component_selector": "model_choice",
  "minibatch_strategy": "epoch_shuffled",
  "skip_perfect_score": false,
  "perfect_score": 1,
  "acceptance": "strict_improvement",
  "proposals_per_round": 1,
  "proposal_selection": "all_improvements",
  "cache_evaluations": true,
  "reflection_strategy": "single",
  "duplication_factor": 2,
  "objective": {
    "invalid_loop_weight": 0.2,
    "token_weight": 0.05,
    "latency_weight": 0,
    "invalid_loop_scale": 1,
    "token_scale": 10000,
    "latency_scale_ms": 60000
  }
}
